generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── İstifadəçilər ───────────────────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  PROVIDER
  ADMIN
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String    @map("password_hash")
  firstName     String    @map("first_name")
  lastName      String    @map("last_name")
  phone         String?   @unique
  avatarUrl     String?   @map("avatar_url")
  role          UserRole  @default(CUSTOMER)
  isVerified    Boolean   @default(false) @map("is_verified")
  isActive      Boolean   @default(true) @map("is_active")
  /** Şifrə dəyişəndə access JWT-ləri etibarsız etmək üçün (iat müqayisəsi) */
  passwordChangedAt DateTime? @map("password_changed_at")
  /** Soft-delete — hard delete əvəzinə; auth rədd edir */
  deletedAt     DateTime? @map("deleted_at")
  lastSeenAt    DateTime? @map("last_seen_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  providerProfile ProviderProfile?
  services        Service[]        @relation("ProviderServices")
  bookingsAsCustomer Booking[]     @relation("CustomerBookings")
  bookingsAsProvider Booking[]     @relation("ProviderBookings")
  reviews         Review[]
  refreshTokens          RefreshToken[]
  notifications          Notification[]
  emailVerificationCodes EmailVerificationCode[]
  conversationsAsCustomer Conversation[] @relation("CustomerConversations")
  conversationsAsProvider Conversation[] @relation("ProviderConversations")
  sentMessages            Message[]      @relation("SentMessages")
  uploadedObjects         UploadedObject[]

  @@index([deletedAt])
  @@map("users")
}

enum EmailVerificationPurpose {
  EMAIL_CHANGE
  SIGNUP_VERIFY
  PASSWORD_RESET
}

model EmailVerificationCode {
  id           String                   @id @default(uuid())
  userId       String                   @map("user_id")
  email        String
  codeHash     String                   @map("code_hash")
  purpose      EmailVerificationPurpose @default(EMAIL_CHANGE)
  /** Səhv kod cəhdləri — limitdə kod ləğv olunur */
  attemptCount Int                      @default(0) @map("attempt_count")
  expiresAt    DateTime                 @map("expires_at")
  createdAt    DateTime                 @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([email, purpose])
  @@map("email_verification_codes")
}

model ProviderProfile {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  bio         String?
  experience  Int?
  location    String?
  isVerified  Boolean  @default(false) @map("is_verified")
  rating      Float    @default(0)
  reviewCount Int      @default(0) @map("review_count")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("provider_profiles")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ─── Kateqoriyalar & Xidmətlər ───────────────────────────────────────────────

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  icon        String?
  sortOrder   Int       @default(0) @map("sort_order")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  services Service[]

  @@map("categories")
}

enum ServiceStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum PriceUnit {
  FIXED
  HOURLY
  DAILY
  PER_SQM
}

enum ServiceVenue {
  AT_LOCATION
  AT_SALON
}

enum CargoRouteScope {
  INTRA_CITY
  INTERCITY
  BOTH
}

model Service {
  id          String        @id @default(uuid())
  title       String
  description String
  price       Decimal       @db.Decimal(10, 2)
  priceUnit   PriceUnit     @default(FIXED) @map("price_unit")
  duration    Int?
  location    String?
  isRemote    Boolean       @default(false) @map("is_remote")
  serviceVenue ServiceVenue? @map("service_venue")
  /** Yükdaşıma: yük yeri uzunluğu (metr) */
  vehicleLength Float?      @map("vehicle_length")
  /** Yükdaşıma: yük yeri eni (metr) */
  vehicleWidth  Float?      @map("vehicle_width")
  /** Yükdaşıma: yük yeri hündürlüyü (metr) */
  vehicleHeight Float?      @map("vehicle_height")
  /** Yükdaşıma: şəhərdaxili / şəhərlərarası */
  cargoRouteScope CargoRouteScope? @map("cargo_route_scope")
  status      ServiceStatus @default(DRAFT)
  providerId  String        @map("provider_id")
  categoryId  String        @map("category_id")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  /** Restrict: hard-delete provider user xidmətləri silməsin — əvvəl soft-delete / archive */
  provider User @relation("ProviderServices", fields: [providerId], references: [id], onDelete: Restrict)
  category Category @relation(fields: [categoryId], references: [id])
  bookings Booking[]
  images   ServiceImage[]
  workingHours          ServiceWorkingHours[]
  availabilityOverrides ServiceAvailabilityOverride[]

  @@index([providerId])
  @@index([categoryId])
  @@index([status])
  @@map("services")
}

model ServiceImage {
  id        String   @id @default(uuid())
  serviceId String   @map("service_id")
  url       String
  alt       String?
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("service_images")
}

// ─── Xidmət təqvimi ──────────────────────────────────────────────────────────

model ServiceWorkingHours {
  id        String  @id @default(uuid())
  serviceId String  @map("service_id")
  dayOfWeek Int     @map("day_of_week") // 0=Bazar ... 6=Şənbə (JS getDay)
  startTime String  @map("start_time") // "09:00"
  endTime   String  @map("end_time") // "18:00"
  isActive  Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, dayOfWeek, startTime])
  @@index([serviceId])
  @@map("service_working_hours")
}

enum AvailabilityOverrideType {
  AVAILABLE
  BLOCKED
}

model ServiceAvailabilityOverride {
  id        String                    @id @default(uuid())
  serviceId String                    @map("service_id")
  date      DateTime                  @db.Date
  startTime String?                   @map("start_time") // null = tam gün
  endTime   String?                   @map("end_time")
  type      AvailabilityOverrideType
  note      String?
  createdAt DateTime                  @default(now()) @map("created_at")
  updatedAt DateTime                  @updatedAt @map("updated_at")

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, date])
  @@map("service_availability_overrides")
}

// ─── Sifarişlər ──────────────────────────────────────────────────────────────

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REJECTED
}

model Booking {
  id                  String        @id @default(uuid())
  serviceId           String        @map("service_id")
  customerId          String        @map("customer_id")
  providerId          String        @map("provider_id")
  scheduledAt         DateTime      @map("scheduled_at")
  proposedScheduledAt DateTime?     @map("proposed_scheduled_at")
  status              BookingStatus @default(PENDING)
  totalPrice  Decimal       @map("total_price") @db.Decimal(10, 2)
  notes       String?
  address     String?
  imageUrl    String?       @map("image_url") @db.Text
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  service  Service  @relation(fields: [serviceId], references: [id])
  customer User     @relation("CustomerBookings", fields: [customerId], references: [id])
  provider User     @relation("ProviderBookings", fields: [providerId], references: [id])
  review       Review?
  conversation Conversation?

  @@index([customerId])
  @@index([providerId])
  @@index([status])
  @@index([serviceId, scheduledAt])
  @@index([scheduledAt])
  @@map("bookings")
}

// ─── Mesajlaşma ──────────────────────────────────────────────────────────────

model Conversation {
  id         String   @id @default(uuid())
  customerId String   @map("customer_id")
  providerId String   @map("provider_id")
  bookingId  String?  @unique @map("booking_id")
  /// Müştəri söhbəti öz siyahısından silib (qarşı tərəfə təsir etmir)
  customerDeletedAt DateTime? @map("customer_deleted_at")
  /// Xidmət verən söhbəti öz siyahısından silib (qarşı tərəfə təsir etmir)
  providerDeletedAt DateTime? @map("provider_deleted_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  customer User      @relation("CustomerConversations", fields: [customerId], references: [id], onDelete: Cascade)
  provider User      @relation("ProviderConversations", fields: [providerId], references: [id], onDelete: Cascade)
  booking  Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  messages Message[]

  @@unique([customerId, providerId])
  @@index([customerId])
  @@index([providerId])
  @@map("conversations")
}

model Message {
  id             String    @id @default(uuid())
  conversationId String    @map("conversation_id")
  senderId       String    @map("sender_id")
  content        String
  isRead         Boolean   @default(false) @map("is_read")
  readAt         DateTime? @map("read_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

// ─── Rəylər ──────────────────────────────────────────────────────────────────

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Review {
  id         String       @id @default(uuid())
  bookingId  String       @unique @map("booking_id")
  authorId   String       @map("author_id")
  rating     Int
  comment    String?
  status     ReviewStatus @default(PENDING)
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  booking Booking @relation(fields: [bookingId], references: [id])
  author  User    @relation(fields: [authorId], references: [id])

  @@index([status])
  @@index([authorId])
  @@map("reviews")
}

// ─── Bildirişlər ─────────────────────────────────────────────────────────────

enum NotificationType {
  BOOKING_CREATED
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  BOOKING_COMPLETED
  BOOKING_RESCHEDULE_PROPOSED
  REVIEW_RECEIVED
  MESSAGE_RECEIVED
  /// Platforma / admin tərəfindən göndərilən bildirişlər (zəng ikonu)
  ADMIN_ANNOUNCEMENT
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  body      String
  data      Json?
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

// ─── Yükləmələr (orphan GC) ──────────────────────────────────────────────────

model UploadedObject {
  id        String   @id @default(uuid())
  key       String   @unique
  url       String
  userId    String   @map("user_id")
  folder    String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("uploaded_objects")
}

/// Ephemeral "yazır..." — multi-instance üçün DB; TTL bitəndə oxunanda silinir
model TypingPresence {
  conversationId String   @id @map("conversation_id")
  userId         String   @map("user_id")
  expiresAt      DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("typing_presences")
}
