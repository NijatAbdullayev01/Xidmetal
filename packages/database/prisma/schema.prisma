generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── İstifadəçilər ───────────────────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  PROVIDER
  ADMIN
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String    @map("password_hash")
  firstName     String    @map("first_name")
  lastName      String    @map("last_name")
  phone         String?
  avatarUrl     String?   @map("avatar_url")
  role          UserRole  @default(CUSTOMER)
  isVerified    Boolean   @default(false) @map("is_verified")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  providerProfile ProviderProfile?
  services        Service[]        @relation("ProviderServices")
  bookingsAsCustomer Booking[]     @relation("CustomerBookings")
  bookingsAsProvider Booking[]     @relation("ProviderBookings")
  reviews         Review[]
  refreshTokens   RefreshToken[]
  notifications   Notification[]

  @@map("users")
}

model ProviderProfile {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  bio         String?
  experience  Int?
  location    String?
  isVerified  Boolean  @default(false) @map("is_verified")
  rating      Float    @default(0)
  reviewCount Int      @default(0) @map("review_count")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("provider_profiles")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ─── Kateqoriyalar & Xidmətlər ───────────────────────────────────────────────

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  icon        String?
  sortOrder   Int       @default(0) @map("sort_order")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  services Service[]

  @@map("categories")
}

enum ServiceStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum PriceUnit {
  FIXED
  HOURLY
  DAILY
}

model Service {
  id          String        @id @default(uuid())
  title       String
  description String
  price       Decimal       @db.Decimal(10, 2)
  priceUnit   PriceUnit     @default(FIXED) @map("price_unit")
  duration    Int?
  location    String?
  isRemote    Boolean       @default(false) @map("is_remote")
  status      ServiceStatus @default(DRAFT)
  providerId  String        @map("provider_id")
  categoryId  String        @map("category_id")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  provider User @relation("ProviderServices", fields: [providerId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])
  bookings Booking[]
  images   ServiceImage[]

  @@index([providerId])
  @@index([categoryId])
  @@index([status])
  @@map("services")
}

model ServiceImage {
  id        String   @id @default(uuid())
  serviceId String   @map("service_id")
  url       String
  alt       String?
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("service_images")
}

// ─── Sifarişlər ──────────────────────────────────────────────────────────────

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REJECTED
}

model Booking {
  id          String        @id @default(uuid())
  serviceId   String        @map("service_id")
  customerId  String        @map("customer_id")
  providerId  String        @map("provider_id")
  scheduledAt DateTime      @map("scheduled_at")
  status      BookingStatus @default(PENDING)
  totalPrice  Decimal       @map("total_price") @db.Decimal(10, 2)
  notes       String?
  address     String?
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  service  Service  @relation(fields: [serviceId], references: [id])
  customer User     @relation("CustomerBookings", fields: [customerId], references: [id])
  provider User     @relation("ProviderBookings", fields: [providerId], references: [id])
  review   Review?

  @@index([customerId])
  @@index([providerId])
  @@index([status])
  @@map("bookings")
}

// ─── Rəylər ──────────────────────────────────────────────────────────────────

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Review {
  id         String       @id @default(uuid())
  bookingId  String       @unique @map("booking_id")
  authorId   String       @map("author_id")
  rating     Int
  comment    String?
  status     ReviewStatus @default(PENDING)
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  booking Booking @relation(fields: [bookingId], references: [id])
  author  User    @relation(fields: [authorId], references: [id])

  @@map("reviews")
}

// ─── Bildirişlər ─────────────────────────────────────────────────────────────

enum NotificationType {
  BOOKING_CREATED
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  BOOKING_COMPLETED
  REVIEW_RECEIVED
  MESSAGE_RECEIVED
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  body      String
  data      Json?
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}
