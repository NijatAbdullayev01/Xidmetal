# Local `pnpm dev` — production `.env` / xidmetal.com portlarını OVERRIDE edir.
# Nest və Next bu faylı development-də `.env`-dən əvvəl oxuyur (mövcud process.env üstünlük).
# Production Docker bu faylı yükləmir (NODE_ENV=production).

NODE_ENV="development"

# Ayrı infra: pnpm docker:dev  (prod Postgres 5434 / Redis 6380 deyil)
DATABASE_URL="postgresql://xidmetal:xidmetal_dev@localhost:5435/xidmetal?schema=public&connection_limit=15&pool_timeout=10"
REDIS_URL="redis://localhost:6381"

JWT_SECRET="dev-only-not-for-production-use-32chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# App portları — canlı sayt 127.0.0.1:{3020,3021,3022,4000} saxlayır
API_PORT=4100
API_LISTEN_HOST="127.0.0.1"
API_URL="http://localhost:4100"
CORS_ORIGIN="http://localhost:3120,http://localhost:3121,http://localhost:3122"
TRUST_PROXY="false"

NEXT_PUBLIC_API_URL=""
NEXT_PUBLIC_WS_URL="http://localhost:4100"
NEXT_PUBLIC_APP_URL="http://localhost:3120"
NEXT_PUBLIC_APP_NAME="Xidmətal"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3121"
NEXT_PUBLIC_PROVIDER_URL="http://localhost:3122"
# Lokal dev GA-ya yazmasın — boş saxla
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

ADMIN_EMAIL="admin@xidmetal.com"
ADMIN_PASSWORD="Admin123!"

# SMTP `.env`-dən gəlir (Resend). Boş SMTP_HOST qoymuruq — dotenv override etməz.

STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./uploads"
STORAGE_PUBLIC_BASE_URL="http://localhost:4100/uploads"

GEOCODER_PROVIDER="mock"
PAYMENTS_ENABLED="false"
NEXT_PUBLIC_PAYMENTS_ENABLED="false"
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
SWAGGER_ENABLED="true"

NEXT_PUBLIC_COMING_SOON="false"