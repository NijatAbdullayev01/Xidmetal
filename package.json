{
  "name": "xidmetal",
  "version": "0.1.0",
  "private": true,
  "description": "Xidmət verənlərlə xidmət alanları bir araya gətirən platforma",
  "scripts": {
    "predev": "pnpm db:generate",
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "test": "turbo test",
    "db:generate": "pnpm --filter @xidmetal/database generate",
    "db:migrate": "bash scripts/with-dev-env.sh pnpm --filter @xidmetal/database migrate",
    "db:migrate:apply": "bash scripts/with-dev-env.sh pnpm --filter @xidmetal/database migrate:deploy",
    "db:migrate:deploy": "pnpm --filter @xidmetal/database migrate:deploy",
    "db:migrate:status": "pnpm --filter @xidmetal/database migrate:status",
    "db:push": "bash scripts/with-dev-env.sh pnpm --filter @xidmetal/database push",
    "db:studio": "bash scripts/with-dev-env.sh pnpm --filter @xidmetal/database studio",
    "db:seed": "bash scripts/with-dev-env.sh pnpm --filter @xidmetal/database seed",
    "load:smoke": "bash ops/load/run.sh smoke",
    "load:stress": "bash ops/load/run.sh stress",
    "load:capacity": "bash ops/load/run.sh capacity",
    "load:capacity-mid": "bash ops/load/run.sh capacity-mid",
    "load:realtime": "node ops/load/realtime-smoke.mjs",
    "docker:dev": "docker compose -f docker-compose.dev.yml up -d",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down",
    "docker:infra": "docker compose -f docker-compose.dev.yml up -d",
    "docker:prod": "bash scripts/docker-prod-up.sh",
    "docker:prod:cloudflare": "bash scripts/docker-prod-up.sh cloudflare",
    "docker:prod:down": "docker compose -f docker-compose.yml -f docker-compose.prod.yml -f docker-compose.cloudflare.yml --env-file .env down",
    "clean": "turbo clean && rm -rf node_modules"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "turbo": "^2.5.4",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@9.2.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
