# Database (docker-compose host port: 5434 → container 5432)
DATABASE_URL="postgresql://xidmetal:xidmetal_dev@localhost:5434/xidmetal?schema=public"

# Redis (docker-compose host port: 6380 → container 6379)
# API rate-limit (throttler) üçün — boşdursa in-memory fallback
REDIS_URL="redis://localhost:6380"

# Runtime — production-da mütləq "production"
NODE_ENV="development"
# Production-da Swagger yalnız SWAGGER_ENABLED=true ilə açılır
# Development-də default açıq; bağlamaq: SWAGGER_ENABLED=false
# SWAGGER_ENABLED="false"

# Reverse proxy (nginx/Cloudflare) arxasında real IP / rate-limit üçün
# TRUST_PROXY="true"

# JWT — access qısa ömürlü httpOnly cookie; refresh 30 gün (DB-də SHA-256 hash)
# PRODUCTION: uzun təsadüfi string (ən azı 32 simvol) — placeholder ilə boot fail olur
JWT_SECRET="change-me-in-production-use-long-random-string"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# API
API_PORT=4000
API_URL="http://localhost:4000"
# Marketplace + Admin (vergüllə ayrılmış origin-lər)
CORS_ORIGIN="http://localhost:3020,http://localhost:3021"

# Web (Next.js --port 3020)
# Boş = eyni origin (Next rewrite → API) — httpOnly cookie üçün məcburidir
NEXT_PUBLIC_API_URL=""
NEXT_PUBLIC_APP_URL="http://localhost:3020"
NEXT_PUBLIC_APP_NAME="Xidmətal"
# Playwright E2E (lokal): E2E_BASE_URL="http://localhost:3020" pnpm --filter @xidmetal/web test:e2e
# CI yalnız e2e/ci-auth.spec.ts işlədir; tam smoke üçün stack + E2E_SKIP_WEBSERVER=1

# Admin panel (ayrı Next.js app — port 3021)
NEXT_PUBLIC_ADMIN_URL="http://localhost:3021"

# Admin seed (pnpm --filter @xidmetal/database seed) — production-da ADMIN_PASSWORD məcburidir
ADMIN_EMAIL="admin@xidmetal.az"
ADMIN_PASSWORD="Admin123!"

# SMTP — production-da MƏCBURİDİR (boş = production-da ServiceUnavailableException)
# Development-də boş ola bilər: kod server log + API previewCode ilə qayıdır
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@xidmetal.az"
# Əlaqə formu mesajlarının ünvanı (boş = SMTP_FROM)
CONTACT_INBOX_EMAIL="info@xidmetal.az"

# Observability — boşdursa Sentry deaktivdir
# API
# SENTRY_DSN=""
# Frontend (web + admin) — brauzer/SSR xətaları
# NEXT_PUBLIC_SENTRY_DSN=""
# SENTRY_TRACES_SAMPLE_RATE="0.1"
# LOG_LEVEL="info"

# Metrics (Prometheus) — GET /api/v1/metrics
# Development: boş = açıq. Production: METRICS_TOKEN məcburidir (Bearer).
# METRICS_TOKEN=""
# Monitoring compose (opsional): Prometheus :9090, Grafana :3001
#   docker compose -f docker-compose.yml -f docker-compose.monitoring.yml --profile monitoring up -d

# Yük testi (k6) — əl ilə: pnpm load:smoke | pnpm load:stress
# BASE_URL="http://localhost:4000"
# LOAD_TEST_TOKEN=""   # opsional JWT (secret commit etmə)

# Geospatial (Faza 2) — geokodlaşdırma adapteri
# mock = stub (default lokal); PRODUCTION: nominatim (və ya öz proxy)
GEOCODER_PROVIDER="mock"
# Nominatim base (GEOCODER_PROVIDER=nominatim olduqda)
# GEOCODER_BASE_URL="https://nominatim.openstreetmap.org"
# İstək User-Agent (Nominatim policy) — boşdursa Xidmetal/1.0
# GEOCODER_USER_AGENT="Xidmetal/1.0 (dev@xidmetal.az)"

# Cloudflare Turnstile (auth + contact bot qorunması)
# Boş = skip (dev). Secret setdirsə login/register/forgot/contact token məcburidir.
# TURNSTILE_SECRET_KEY=""
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# Real-time / tracking (Faza 3)
# Socket.IO CORS — boşdursa CORS_ORIGIN / NEXT_PUBLIC_* URL-lər istifadə olunur
# SOCKET_CORS_ORIGIN="http://localhost:3020,http://localhost:3021"
# Frontend WS origin (REST eyni-origin rewrite olsa belə Socket.IO birbaşa API)
NEXT_PUBLIC_WS_URL="http://localhost:4000"
# Mapbox GL JS (müştəri xəritə) — boşdursa AZ empty state, build sınmır
NEXT_PUBLIC_MAPBOX_TOKEN=""
# Mapbox Directions (server ETA) — boşdursa haversine + orta sürət fallback
MAPBOX_ACCESS_TOKEN=""

# On-demand dispatch (Faza 4)
# Yaxınlıq radiusu (metr) — default 15000 (15 km)
DISPATCH_RADIUS_M="15000"
# Təklif timeout (saniyə) — default 30
DISPATCH_OFFER_TIMEOUT_SEC="30"
# BullMQ Redis prefix (REDIS_URL tələb olunur; yoxdursa dev-də in-process setTimeout)
# DISPATCH_QUEUE_PREFIX="xidmetal:dispatch"

# Fayl saxlama: local (default) və ya s3 (R2/S3 uyğun)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./uploads"
STORAGE_PUBLIC_BASE_URL="http://localhost:4000/uploads"
# Media HMAC (opsional) — boşdursa JWT_SECRET; JWT rotasiyasından ayırmaq üçün tövsiyə olunur
# MEDIA_SIGNING_SECRET=""
# S3 / Cloudflare R2 (STORAGE_DRIVER=s3 olduqda)
# S3_ENDPOINT="https://xxxx.r2.cloudflarestorage.com"
# S3_REGION="auto"
# S3_BUCKET="xidmetal"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# Canonical URL bazası (allowlist). bookings/ public OLMAMALIDIR —
# oxuma S3 GetObject presigned URL ilə aparılır.
# S3_PUBLIC_URL="https://cdn.example.com"

# ─── Faza 5: Ödəniş (default OFF — marketplace ödənişsiz qalır) ───────────────
# true olmadıqda /payments/* → 501 "Ödəniş hələ aktiv deyil"; booking side-effect yox
PAYMENTS_ENABLED="false"
# Public UI flag (checkout yox; default false)
NEXT_PUBLIC_PAYMENTS_ENABLED="false"
# noop (default) | stripe (skeleton — real charge yalnız Stripe secret + gələcək webhook ilə)
PAYMENT_PROVIDER="noop"
# STRIPE_SECRET_KEY=""
# Webhook endpoint hələ yoxdur — secret gələcək Stripe webhook üçün saxlanılır
# STRIPE_WEBHOOK_SECRET=""

# İdempotencyRecord TTL (saat) — API saatlıq cleanup ilə silir
IDEMPOTENCY_TTL_HOURS="24"

# ─── Faza 5: Push (FCM) ───────────────────────────────────────────────────────
# Credentials yoxdursa API noop + log; frontend kart gizlədilir
# Real göndərmə: FCM_PROJECT_ID + GOOGLE_APPLICATION_CREDENTIALS (HTTP v1)
# və ya legacy FCM_SERVER_KEY
# FCM_PROJECT_ID=""
# GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account.json"
# FCM_SERVER_KEY=""
# Web (Firebase messaging.getToken — bütün sahələr tələb olunur):
# NEXT_PUBLIC_FCM_VAPID_KEY=""
# NEXT_PUBLIC_FCM_API_KEY=""
# NEXT_PUBLIC_FCM_PROJECT_ID=""
# NEXT_PUBLIC_FCM_APP_ID=""
# NEXT_PUBLIC_FCM_MESSAGING_SENDER_ID=""

# ─── Faza 5: SMS ──────────────────────────────────────────────────────────────
# noop (default) | console (log) | twilio (real Messages API)
SMS_PROVIDER="noop"
# Kritik booking status SMS — yalnız true + təsdiqlənmiş phone (phoneVerifiedAt)
SMS_STATUS_ENABLED="false"
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM_NUMBER=""
