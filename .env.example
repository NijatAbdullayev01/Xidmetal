# ─── İki mühit (eyni VPS-də paralel işləyə bilər) ───────────────────────────
# Production (xidmetal.com): bu faylı `.env` kimi kopyalayıb `pnpm docker:prod`.
#   Host: 127.0.0.1:3020 (web) / 3021 (admin) / 4000 (API), Postgres 5434, Redis 6380
# Development (`pnpm dev`): committed `.env.development` + `pnpm docker:dev`.
#   Host: 127.0.0.1:3120 / 3121 / 4100, Postgres 5435, Redis 6381
# `pnpm docker:prod:down` və `docker compose down` canlı saytı dayandırır.
#
# Database (production compose host port: 127.0.0.1:5434 → container 5432)
# Pool: connection_limit × API_REPLICAS < Postgres max_connections (prod ~300)
# Production: POSTGRES_PASSWORD / DATABASE_URL-də xidmetal_dev qadağandır
DATABASE_URL="postgresql://xidmetal:xidmetal_dev@localhost:5434/xidmetal?schema=public&connection_limit=15&pool_timeout=10"
# POSTGRES_PASSWORD="xidmetal_dev"
# PRISMA_CONNECTION_LIMIT="15"

# Redis (docker-compose host port: 127.0.0.1:6380 → container 6379)
# API: throttler + Socket.IO adapter + BullMQ + location throttle/presence — boşdursa in-memory fallback
# Production: AUTH parolu məcburidir (docker-compose.prod.yml --requirepass)
REDIS_URL="redis://localhost:6380"
# REDIS_PASSWORD="change-me-in-production-use-long-random-string"
# REDIS_URL="redis://:change-me-in-production-use-long-random-string@localhost:6380"
# REDIS_URL_DOCKER="redis://:change-me-in-production-use-long-random-string@redis:6379"

# Grafana (opsional monitoring compose) — default admin/admin qadağandır
# GRAFANA_ADMIN_PASSWORD=""

# Runtime — production-da mütləq "production"
NODE_ENV="development"
# Production-da Swagger yalnız SWAGGER_ENABLED=true ilə açılır
# Development-də default açıq; bağlamaq: SWAGGER_ENABLED=false
# SWAGGER_ENABLED="false"

# Reverse proxy (nginx/Cloudflare) arxasında real IP / rate-limit.
# api-proxy X-Forwarded-For-u host nginx X-Real-IP ilə əvəz edir → TRUST_PROXY=1 (production default).
# İki qat XFF append olsa: TRUST_PROXY=2
TRUST_PROXY="true"
# Production-da SWAGGER_ENABLED qoymayın (default-deny). Yalnız diaqnostika: SWAGGER_ENABLED=true
# Global HTTP throttle (req / 60s / IP) — 5k concurrent üçün default 300
# THROTTLE_LIMIT="300"

# Prod API replica sayı: docker compose ... --scale api=3
# API_REPLICAS="3"

# JWT — access qısa ömürlü httpOnly cookie; refresh 30 gün (DB-də SHA-256 hash)
# PRODUCTION: uzun təsadüfi string (ən azı 32 simvol) — placeholder ilə boot fail olur
JWT_SECRET="change-me-in-production-use-long-random-string"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# API (production Docker konteyner içində 4000; host map: API_HOST_PORT)
# Lokal `pnpm dev` API_PORT-u `.env.development` ilə 4100 edir — 4000-i tutmur
API_PORT=4000
# Dev-də default 127.0.0.1 (canlı 4000-i internetə açmamaq üçün)
# API_LISTEN_HOST="127.0.0.1"
# Docker/SSR build-ləri üçün production-da MƏCBURİDİR
API_URL="http://localhost:4000"
# Marketplace + Admin (vergüllə ayrılmış origin-lər)
CORS_ORIGIN="http://localhost:3020,http://localhost:3021"

# Web (production Next.js 3020; `pnpm dev` 3120 — bax: .env.development)
# Boş = eyni origin (Next rewrite → API) — httpOnly cookie üçün məcburidir
# Docker image build edərkən `API_URL` və uyğun app URL mütləq ötürülməlidir
NEXT_PUBLIC_API_URL=""
NEXT_PUBLIC_APP_URL="http://localhost:3020"
NEXT_PUBLIC_APP_NAME="Xidmətal"
# Canlı marketplace-də müvəqqəti «Tezliklə» ekranı (dashboard/login açıq qalır)
NEXT_PUBLIC_COMING_SOON="false"
# Playwright E2E (lokal): E2E_BASE_URL="http://localhost:3020" pnpm --filter @xidmetal/web test:e2e
# CI yalnız e2e/ci-auth.spec.ts işlədir; tam smoke üçün stack + E2E_SKIP_WEBSERVER=1

# Admin panel (production 3021; `pnpm dev` 3121)
NEXT_PUBLIC_ADMIN_URL="http://localhost:3021"

# Admin seed (pnpm --filter @xidmetal/database seed) — production-da ADMIN_PASSWORD məcburidir
ADMIN_EMAIL="admin@xidmetal.com"
ADMIN_PASSWORD="Admin123!"

# SMTP — production-da MƏCBURİDİR (boş = production-da ServiceUnavailableException)
# Development-də boş saxla: kod server log + API previewCode ilə qayıdır.
# localhost/127.0.0.1 yalnız lokal Mailpit/MailHog işləyəndə; production-da qadağandır.
# Spam/inbox: docs/EMAIL.md — SPF+DMARC (provision-dns.sh), Resend DKIM, SMTP_FROM=mail@…
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="mail@xidmetal.com"
# Cavab ünvanı (boş = CONTACT_INBOX_EMAIL). no-reply istifadə etməyin.
MAIL_REPLY_TO="info@xidmetal.com"
# SMTP EHLO adı (boş = SMTP_FROM domeni)
# MAIL_HELO_NAME="xidmetal.com"
# Əlaqə formu mesajlarının ünvanı (boş = SMTP_FROM)
CONTACT_INBOX_EMAIL="info@xidmetal.com"

# Observability — boşdursa Sentry deaktivdir
# API
# SENTRY_DSN=""
# Frontend (web + admin) — brauzer/SSR xətaları
# NEXT_PUBLIC_SENTRY_DSN=""
# SENTRY_TRACES_SAMPLE_RATE="0.1"
# LOG_LEVEL="info"

# Metrics (Prometheus) — GET /api/v1/metrics
# Development: boş = açıq. Production boot: METRICS_TOKEN məcburidir (fail-fast).
# METRICS_TOKEN=""
# Monitoring compose (opsional): Prometheus :9090, Grafana :3001
#   docker compose -f docker-compose.yml -f docker-compose.monitoring.yml --profile monitoring up -d

# Yük testi (k6) — əl ilə: pnpm load:smoke | pnpm load:stress
# Socket.IO smoke: pnpm load:realtime
# BASE_URL="http://localhost:4000"
# LOAD_TEST_TOKEN=""   # opsional JWT (secret commit etmə)

# Full stack Docker (infra + api/web/admin + nginx LB):
#   API_REPLICAS=3 pnpm docker:prod
# Lokal inkişaf infra (prod-a toxunmur): pnpm docker:dev
# Konteyner şəbəkəsi üçün (compose.prod override):
# DATABASE_URL_DOCKER="postgresql://xidmetal:xidmetal_dev@postgres:5432/xidmetal?schema=public&connection_limit=15&pool_timeout=10"
# REDIS_URL_DOCKER="redis://redis:6379"
# API_URL_INTERNAL="http://api-proxy:4000"

# Geospatial (Faza 2) — geokodlaşdırma adapteri
# mock = stub (default lokal); PRODUCTION boot: mock qadağandır → nominatim
GEOCODER_PROVIDER="mock"
# Nominatim base (GEOCODER_PROVIDER=nominatim olduqda)
# GEOCODER_BASE_URL="https://nominatim.openstreetmap.org"
# Opsional allowlist (vergüllə ayrılmış hostlar) — default: nominatim.openstreetmap.org
# GEOCODER_ALLOWED_HOSTS="nominatim.openstreetmap.org"
# İstək User-Agent (Nominatim policy) — boşdursa Xidmetal/1.0
# GEOCODER_USER_AGENT="Xidmetal/1.0 (dev@xidmetal.com)"

# Cloudflare Turnstile (auth + contact bot qorunması)
# Boş = skip (dev). Production boot: TURNSTILE_SECRET_KEY məcburidir (fail-fast).
# Dummy/test açar (1x000000…) captcha skip + widget gizlədilir; real widget: ops/cloudflare/provision-turnstile.sh
# Real widget: CLOUDFLARE_API_TOKEN=… ./ops/cloudflare/provision-turnstile.sh
# TURNSTILE_SECRET_KEY=""
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# Real-time / tracking (Faza 3)
# Socket.IO CORS — boşdursa CORS_ORIGIN / NEXT_PUBLIC_* URL-lər istifadə olunur
# SOCKET_CORS_ORIGIN="http://localhost:3020,http://localhost:3021"
# Frontend WS origin (REST eyni-origin rewrite olsa belə Socket.IO birbaşa API)
# Lokal docker:prod: http://localhost:4000
# Cloudflare edge: boş saxla (eyni host /socket.io) — image-i yenidən build et
NEXT_PUBLIC_WS_URL="http://localhost:4000"
# Server Directions ETA — Routes API (New) aktiv olanda istifadə olunur
# Boşdursa OSRM, sonra Mapbox, sonra haversine
GOOGLE_MAPS_API_KEY=""
# OSRM routing (default public demo) — öz server: https://osrm.example.com
# OSRM_BASE_URL="https://router.project-osrm.org"
# Opsional host allowlist (vergüllə). Default: router.project-osrm.org
# Docker daxili OSRM: OSRM_BASE_URL="http://osrm:5000" OSRM_ALLOWED_HOSTS="osrm,router.project-osrm.org"
# OSRM_ALLOWED_HOSTS="router.project-osrm.org"
# Mapbox Directions (opsional)
MAPBOX_ACCESS_TOKEN=""
# Client-də embedded xəritə yoxdur. NEXT_PUBLIC_GOOGLE_MAPS_API_KEY production-da
# Routes API üçün istifadə olunmur — yalnız GOOGLE_MAPS_API_KEY.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# On-demand dispatch (Faza 4)
# Ümumi axtarış pəncərəsi (saniyə) — default 600; tək təklif timeout yoxdur
DISPATCH_SEARCH_WINDOW_SEC="600"
# Yeni ONLINE xidmət verənlər üçün yenidən axtarış intervalı (saniyə) — default 30
DISPATCH_REDISCOVERY_INTERVAL_SEC="30"
# İmtina sonrası eyni xidmət verənə yenidən təklif gözləməsi (saniyə) — default 120
DISPATCH_DECLINE_REOFFER_COOLDOWN_SEC="120"
# BullMQ Redis prefix (REDIS_URL tələb olunur; yoxdursa dev-də in-process setTimeout)
# DISPATCH_QUEUE_PREFIX="xidmetal:dispatch"

# Fayl saxlama: local (default) və ya s3 (R2/S3 uyğun)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./uploads"
STORAGE_PUBLIC_BASE_URL="http://localhost:4000/uploads"
# Media HMAC — production-da MƏCBURİ ayrıca secret; dev-də boş olduqda JWT_SECRET fallback
# MEDIA_SIGNING_SECRET=""
# S3 / Cloudflare R2 (STORAGE_DRIVER=s3 olduqda)
# S3_ENDPOINT="https://xxxx.r2.cloudflarestorage.com"
# S3_REGION="auto"
# S3_BUCKET="xidmetal"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# Canonical URL bazası (allowlist). bookings/ public OLMAMALIDIR —
# oxuma S3 GetObject presigned URL ilə aparılır.
# S3_PUBLIC_URL="https://cdn.example.com"

# ─── Faza 5: Ödəniş (default OFF — marketplace ödənişsiz qalır) ───────────────
# true olmadıqda /payments/* → 501 "Ödəniş hələ aktiv deyil"; booking side-effect yox
# Production boot: PAYMENTS_ENABLED=true və/və ya PAYMENT_PROVIDER=stripe → fail-fast
PAYMENTS_ENABLED="false"
# Public UI flag (checkout yox; default false)
NEXT_PUBLIC_PAYMENTS_ENABLED="false"
# noop (default) | stripe (stub — bütün əməliyyatlar 501; real charge yoxdur)
PAYMENT_PROVIDER="noop"
# STRIPE_SECRET_KEY=""
# Webhook endpoint hələ yoxdur — secret gələcək Stripe webhook üçün saxlanılır
# STRIPE_WEBHOOK_SECRET=""

# İdempotencyRecord TTL (saat) — API saatlıq cleanup ilə silir
IDEMPOTENCY_TTL_HOURS="24"

# ─── Faza 5: Push (FCM) ───────────────────────────────────────────────────────
# Credentials yoxdursa API noop + log; frontend kart gizlədilir
# Real göndərmə: FCM_PROJECT_ID + GOOGLE_APPLICATION_CREDENTIALS (HTTP v1)
# və ya legacy FCM_SERVER_KEY
# FCM_PROJECT_ID=""
# GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account.json"
# FCM_SERVER_KEY=""
# Web (Firebase messaging.getToken — bütün sahələr tələb olunur):
# NEXT_PUBLIC_FCM_VAPID_KEY=""
# NEXT_PUBLIC_FCM_API_KEY=""
# NEXT_PUBLIC_FCM_PROJECT_ID=""
# NEXT_PUBLIC_FCM_APP_ID=""
# NEXT_PUBLIC_FCM_MESSAGING_SENDER_ID=""

# ─── Cloudflare (VPS origin + proxied DNS) ─────────────────────────────────
# Domain: xidmetal.com  Origin IP: 77.42.42.63
# Shared VPS (bu host — :80/:443 it-market.org ilə paylaşılır):
#   ops/nginx/xidmetal.com.conf → /etc/nginx/sites-enabled/
#   CLOUDFLARE_API_TOKEN=… ./ops/cloudflare/provision-dns.sh  (A + SPF + DMARC)
#   WRITE_ENV=1 CLOUDFLARE_API_TOKEN=… ./ops/cloudflare/provision-turnstile.sh
# Dedicated VPS (boş 80/443): pnpm docker:prod:cloudflare
# DNS (proxied / orange cloud):
#   A     @                 77.42.42.63
#   A     www               77.42.42.63
#   A     admin             77.42.42.63
# SSL/TLS: Full (origin self-signed və ya Origin CA). Full (strict) üçün
# Origin CA → ops/certs/origin.pem + origin.key
# Cloudflare: WebSockets ON, Always Use HTTPS ON.
# Google Maps API key HTTP referrer: https://xidmetal.com/* https://admin.xidmetal.com/*
#
# WEB_HOST="xidmetal.com"
# WWW_HOST="www.xidmetal.com"
# ADMIN_HOST="admin.xidmetal.com"
# WEB_HOST_PORT="127.0.0.1:3020"
# ADMIN_HOST_PORT="127.0.0.1:3021"
# API_HOST_PORT="127.0.0.1:4000"
# CORS_ORIGIN="https://xidmetal.com,https://www.xidmetal.com,https://admin.xidmetal.com"
# NEXT_PUBLIC_APP_URL="https://xidmetal.com"
# NEXT_PUBLIC_ADMIN_URL="https://admin.xidmetal.com"
# NEXT_PUBLIC_WS_URL=""
# NEXT_PUBLIC_API_URL=""
# API_URL="http://localhost:4000"
# TRUST_PROXY="true"
