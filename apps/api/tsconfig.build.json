{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": "./src",
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "paths": {
      "@/*": ["src/*"],
      "@xidmetal/shared": ["../../packages/shared/dist/index.d.ts"],
      "@xidmetal/database": ["../../packages/database/dist/index.d.ts"]
    }
  },
  "exclude": ["node_modules", "dist", "test", "**/*spec.ts"]
}
